    },
    {
      "name": "06 - OpenAPI Security & Deprecation Metadata",
      "item": [
        {
          "name": "GET /openapi.json metadata checks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/openapi.json",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "openapi.json"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var doc = pm.response.json();",
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('ApiKeyAuth security scheme exists', function () {",
                  "  pm.expect(doc.components.securitySchemes.ApiKeyAuth).to.exist;",
                  "  pm.expect(doc.components.securitySchemes.ApiKeyAuth.name).to.eql('X-API-Key');",
                  "});",
                  "pm.test('Accounts endpoint requires ApiKeyAuth', function () {",
                  "  pm.expect(doc.paths['/api/accounts/'].get.security).to.deep.include({ ApiKeyAuth: [] });",
                  "});",
                  "pm.test('Legacy endpoint marked deprecated', function () {",
                  "  pm.expect(doc.paths['/api/journal-entries/legacy'].post.deprecated).to.eql(true);",
                  "});",
                  "pm.test('Legacy schema fields marked deprecated', function () {",
                  "  pm.expect(doc.components.schemas.JournalEntryCreate.properties.account_id.deprecated).to.eql(true);",
                  "  pm.expect(doc.components.schemas.JournalEntryUpdate.properties.amount.deprecated).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
