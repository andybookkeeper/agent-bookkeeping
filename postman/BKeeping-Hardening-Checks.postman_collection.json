    {
      "name": "03 - Setup Accounts For Pair Tests",
      "item": [
        {
          "name": "Create Debit Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key_write}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pair Debit {{timestamp}}\",\n  \"type\": \"asset\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/accounts/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "accounts",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('timestamp', Date.now().toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.collectionVariables.set('debit_account_id', data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Credit Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key_write}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pair Credit {{timestamp}}\",\n  \"type\": \"revenue\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/accounts/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "accounts",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.collectionVariables.set('credit_account_id', data.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Strict Pair Posting",
      "item": [
        {
          "name": "Invalid Pair (Same Account -> 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key_write}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{$isoTimestamp}}\",\n  \"description\": \"Invalid same account\",\n  \"debit_account_id\": \"{{debit_account_id}}\",\n  \"credit_account_id\": \"{{debit_account_id}}\",\n  \"amount\": 10\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/journal-entries/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "journal-entries",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Valid Pair (201 + capture entry)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key_write}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{$isoTimestamp}}\",\n  \"description\": \"Valid pair posting\",\n  \"debit_account_id\": \"{{debit_account_id}}\",\n  \"credit_account_id\": \"{{credit_account_id}}\",\n  \"amount\": 15\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/journal-entries/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "journal-entries",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test('Returns two entries', function () {",
                  "  pm.expect(Array.isArray(data)).to.be.true;",
                  "  pm.expect(data.length).to.eql(2);",
                  "});",
                  "pm.test('Both share same pair_id', function () {",
                  "  pm.expect(data[0].pair_id).to.eql(data[1].pair_id);",
                  "});",
                  "pm.collectionVariables.set('pair_entry_id', data[0].id);",
                  "pm.collectionVariables.set('pair_id', data[0].pair_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Pair Amount (both sides)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key_write}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 22\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/journal-entries/{{pair_entry_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "journal-entries",
                "{{pair_entry_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test('Both entries updated to 22', function () {",
                  "  pm.expect(data[0].amount).to.eql(22);",
                  "  pm.expect(data[1].amount).to.eql(22);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Pair",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key_write}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/journal-entries/{{pair_entry_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "journal-entries",
                "{{pair_entry_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', function () {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm Pair Entry Deleted",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key_write}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/journal-entries/{{pair_entry_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "journal-entries",
                "{{pair_entry_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', function () {",
                  "  pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
