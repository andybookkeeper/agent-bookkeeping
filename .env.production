# Production Environment Configuration
# Copy to .env and update values before deploying

# Environment
ENV=production
LOG_LEVEL=INFO

# Database
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://bookkeeper:your_secure_password_here@db.example.com:5432/bookkeeping

# Redis
REDIS_URL=redis://redis.example.com:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Frontend
NEXT_PUBLIC_API_URL=https://api.example.com
NODE_ENV=production

# CORS - Restrict to your domain
ALLOWED_ORIGINS=https://app.example.com,https://api.example.com

# Logging
LOG_DIR=/var/log/bookkeeper

# Security
SQL_ECHO=false

# SSL/TLS (if using reverse proxy)
TRUST_PROXY=1
